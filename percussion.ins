# BeatBax Game Boy Percussion Instruments
# Shareable instrument library for drums and percussion
# Repository: beatbax/instruments-gb

# === KICK DRUMS ===

# Deep kick drum
inst kick type=noise env=12,down

# Short punchy kick
inst kick_short type=noise env=8,down

# Heavy 808-style kick
inst kick_808 type=noise env=15,down

# === SNARE DRUMS ===

# Classic snare
inst snare type=noise env=10,down

# Tight snare
inst snare_tight type=noise env=7,down

# Long snare with tail
inst snare_long type=noise env=13,down

# === HI-HATS ===

# Closed hi-hat
inst hat type=noise env=4,down

# Open hi-hat
inst hat_open type=noise env=8,down

# Pedal hi-hat
inst hat_pedal type=noise env=5,down

# === CYMBALS ===

# Crash cymbal
inst crash type=noise env=14,down

# Ride cymbal
inst ride type=noise env=9,flat

# === TOMS ===

# High tom
inst tom_high type=noise env=9,down

# Mid tom
inst tom_mid type=noise env=10,down

# Low tom (floor tom)
inst tom_low type=noise env=12,down

# === CLAPS & SNAPS ===

# Hand clap
inst clap type=noise env=6,down

# Finger snap
inst snap type=noise env=4,down

# === PERCUSSION ===

# Rim shot
inst rim type=noise env=5,down

# Wood block
inst wood type=noise env=7,down

# Cowbell
inst cowbell type=noise env=11,flat
