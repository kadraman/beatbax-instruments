# BeatBax NES DMC sample instruments — self-contained (remote-safe)
# Uses engine-bundled @nes/* samples (no .dmc binaries in this repo)
# Source: nes_dmc_demo, battle_fanfare, covers
# Import: github:kadraman/beatbax-instruments/main/nes/dmc.ins

# Bundled samples: bongo, clap, crash, high_tom, hihat, kick, low_tom,
# middle_tom, muted_bongo, snare, bass_c2
inst kick_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/kick"
inst snare_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/snare"
inst clap_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/clap"
inst crash_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/crash"
inst hihat_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/hihat"
inst bongo_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/bongo"
inst muted_bongo_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/muted_bongo"
inst high_tom_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/high_tom"
inst middle_tom_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/middle_tom"
inst low_tom_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/low_tom"
inst bass_dmc type=dmc dmc_rate=15 dmc_loop=false dmc_sample="@nes/bass_c2"
inst bass_slow_dmc type=dmc dmc_rate=4 dmc_loop=false dmc_sample="@nes/bass_c2"
